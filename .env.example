# ─────────────────────────────────────────────
#  Safe Assets Dashboard — Environment Variables
#  Copy this file to .env and fill in values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRY=8h

# Admin credentials
ADMIN_USERNAME=rasi
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# n8n — base URL of your n8n instance (no trailing slash)
# All Chatwoot, leads, analytics, and WhatsApp calls route through n8n webhooks
N8N_WEBHOOK_BASE_URL=https://n8n.aiingo.com

# NocoDB — base and leads IDs extracted from n8n workflow
NOCODB_API_URL=http://localhost:8080
NOCODB_API_TOKEN=
NOCODB_BASE_ID=pbe6o8e586pox0p
NOCODB_LEADS_TABLE_ID=mk1og9rbenjlw13
# Config table: create a new table in NocoDB and paste its ID here
NOCODB_CONFIG_TABLE_ID=

# Chatwoot
CHATWOOT_API_URL=https://app.aiingo.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=10

# WhatsApp Business API (Meta Graph API)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1188059964386888
WHATSAPP_BUSINESS_ACCOUNT_ID=1318069613633545

# Server
PORT=4000
NODE_ENV=production

# CORS — set to your actual domain
CORS_ORIGIN=https://dashboard.safeassetsofficial.com
