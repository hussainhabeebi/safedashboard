# ─────────────────────────────────────────────
#  Safe Assets Dashboard — Environment Variables
#  Copy this file to .env and fill in values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRY=8h

# Admin credentials
ADMIN_USERNAME=rasi
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# NocoDB — fill in after creating tables
NOCODB_API_URL=http://localhost:8080
NOCODB_API_TOKEN=
NOCODB_BASE_ID=
NOCODB_LEADS_TABLE_ID=
NOCODB_CONFIG_TABLE_ID=

# Chatwoot
CHATWOOT_API_URL=https://app.aiingo.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=10

# Server
PORT=4000
NODE_ENV=production

# CORS — set to your actual domain
CORS_ORIGIN=https://dashboard.safeassetsofficial.com
